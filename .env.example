# --- Provided automatically by Railway ---
# When you add a Postgres database in your Railway project and reference it,
# Railway injects DATABASE_URL for you. You do NOT set this by hand.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Railway also injects PORT automatically. Local default is 3000.
# PORT=3000

# --- Optional ---
# Require a passcode to view the /results dashboard. Leave unset to make
# results open to anyone with the link.
# RESULTS_PASSCODE=changeme
